{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jd-viewer/public/hardware/parts.json",
  "type": "object",
  "required": ["schema", "updated_at", "parts"],
  "properties": {
    "schema": {"const": 1},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "name", "maker", "status", "specs", "perf", "sources", "checked_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^(gpu|cpu|ram|ssd|hdd|mb|psu|cooler|case)-[a-z0-9-]+$"},
          "category": {"enum": ["gpu", "cpu", "ram", "ssd", "hdd", "mainboard", "psu", "cooler", "case"]},
          "name": {"type": "string", "minLength": 2},
          "maker": {"type": "string"},
          "released": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$"},
          "status": {"enum": ["current", "legacy"]},
          "specs": {"type": "object"},
          "perf": {
            "type": "object",
            "required": ["index", "basis", "confidence"],
            "properties": {
              "index": {"type": "number", "minimum": 0},
              "multi": {"type": "number", "minimum": 0},
              "basis": {"type": "string"},
              "confidence": {"enum": ["seed", "low", "medium", "high"]}
            }
          },
          "price_query": {
            "type": "object",
            "required": ["q"],
            "properties": {
              "q": {"type": "string"},
              "cate": {"type": "string", "description": "다나와 분류 표기의 일부 — 그래픽카드·CPU·RAM·SSD·HDD·메인보드·파워·쿨러·케이스"},
              "must": {"type": "array", "items": {"type": "string"}, "description": "상품명에 모두 있어야 할 말. 'GOLD|골드' 처럼 | 로 적으면 그중 하나"},
              "not": {"type": "array", "items": {"type": "string"}},
              "per": {"type": "integer", "minimum": 2, "description": "묶음으로만 파는 부품 — 묶음 가격을 이 수로 나눠 한 개 값으로 적는다(예: 메모리 32Gx2 패키지 → 2)"}
            }
          },
          "price_basis": {"enum": ["min", "median"], "description": "median — 특정 상품이 아니라 급(級)이라 매물 가운데 값을 쓴다"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}}
          },
          "checked_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
