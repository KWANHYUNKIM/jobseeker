# 뷰어 API(backend) 환경변수 — 실제 값은 .env 나 launchd plist 에 둔다(.env 는 Git 제외).

# 정본 DB. 크롤 파이프라인(catch_capture)과 같은 DB 를 가리킨다.
JOBSEEKER_DSN=postgresql://jobseeker:jobseeker@127.0.0.1:5433/jobseeker

# 바인드 주소·포트. launchd 는 0.0.0.0 으로 연다(뷰어 nginx 컨테이너가 host.docker.internal 로 붙는다).
SEARCH_HOST=127.0.0.1
API_PORT=8771
API_WORKERS=1

# 같은 질의를 들고 있는 시간(초). 0 이면 끈다.
API_CACHE_TTL=60

# 질의 임베딩(Ollama). 파이프라인이 공고를 임베딩한 모델·차원과 같아야 한다.
OLLAMA_URL=http://127.0.0.1:11434
SEMANTIC_EMBED_MODEL=bge-m3
SEMANTIC_EMBED_DIM=1024
API_EMBED_TIMEOUT=20
