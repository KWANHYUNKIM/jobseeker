# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Logs & PIDs
*.log
logs/
*.pid

# Runtime state
.runs/
catch_capture/seen_jobs.json
catch_capture/.browser_state.json
catch_capture/.browser_daemon.log
catch_capture/.chrome_profile/

# Captured screenshots (regenerated by crawlers)
catch_capture/screenshots/

# 관리자(비공개) — 개인 이력/지원/생성물·API키. 절대 커밋 금지
catch_capture/admin/data/
catch_capture/admin/.secrets.json

# 기술 블로그 본문/번역 (크롤러가 서버에서 생성하는 글별 데이터 — 인덱스 tech_blogs.json만 추적)
jd-viewer/public/blog_content/

# catch_capture/screenshots(=gitignore 대상) 를 가리키는 심링크. 클론한 트리에는
# 타겟이 없어 `vite build` 가 public/ 을 복사하다 ENOENT 로 죽는다.
# 뷰어는 all_jobs_enriched.json 만 fetch 하므로 추적할 이유가 없다.
jd-viewer/public/all_jobs.json

# 학습 영상 수집 캐시 (build_learning.py 증분 수집용 — 결과 learning_resources.json만 추적)
jd-viewer/bin/.learning_cache.json
# 자동 갱신 cron 로그·락
jd-viewer/bin/refresh-learning.log
jd-viewer/bin/.refresh-learning.lock/

# 배포 시크릿 — Cloudflare 터널 토큰 등. 절대 커밋 금지 (.env.example 만 추적)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Local Claude settings
.claude/settings.local.json
.claude/worktrees/

# 런타임 생성 학습 갱신 타임스탬프
.learning_refresh.stamp

# 생성 데이터 — 크롤 파이프라인이 매 사이클 다시 만든다.
# git 으로 나르지 않는 이유: 사이클마다 수십 MB 가 바뀌어 이력이 데이터로 뒤덮이고,
# 크롤러가 워킹트리를 늘 더럽혀 배포의 `git merge --ff-only` 가 막혔다(실제로 배포가
# 며칠 막혀 뷰어가 낡은 채로 서비스됐다). 새 서버로 옮길 때는 deploy/seed-server.sh
# 가 rsync 로 나른다. 사람이 쓴 파일(favicon.svg, icons.svg)은 그대로 추적한다.
jd-viewer/public/*.json
jd-viewer/public/mindmap.md
jd-viewer/public/blog_keywords.md
catch_capture/dashboard/data.json

# 빌더 캐시 (재수집 비용만 줄이는 로컬 파일)
jd-viewer/bin/.inflearn_cache/

# 재공고 추적 히스토리 — 사이클마다 누적되는 로컬 데이터.
# 같은 성격의 closed_*.json 아카이브와 마찬가지로 git 밖에 둔다.
# 지워도 build_reposts.py 가 마감 아카이브에서 다시 부트스트랩한다.
catch_capture/job_history.jsonl

# 인프런 수집 주기 스탬프 (로컬 실행 기록)
catch_capture/.inflearn_refresh.stamp

# 취업 브리핑 엔진이 공고 60MB 를 매번 안 읽으려고 만드는 캐시 (원본에서 재생성됨)
guide-engine/state/.jobs_cache.json

# 자동 브리핑 산출물 (guide-engine/autoguide.py 가 크롤 데이터에서 재생성 — 814곳 25MB).
# 손으로 쓴 브리핑(jd-viewer/public/guide/companies/)은 그대로 추적한다. 저쪽은
# 사람이 판단해서 쓴 글이라 되살릴 수 없고, 여기는 --all 한 번이면 56초에 다시 난다.
jd-viewer/public/guide/auto/
